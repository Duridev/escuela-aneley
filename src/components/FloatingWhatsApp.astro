---
// FloatingWhatsApp.astro - Botones flotantes: Matrículas 2027 (Modal) + WhatsApp directo
---

<div class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex flex-col items-end gap-3.5">
  <!-- Floating Action 1: Matrículas Año 2027 (Opens Modal) -->
  <div class="flex items-center gap-3 group">
    <button
      type="button"
      data-open-admission-modal
      class="flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-white shadow-card border border-aneley-yellow/70 text-xs sm:text-sm font-heading font-bold text-aneley-purple hover:bg-aneley-yellow-soft transition-all duration-300 group-hover:scale-105 cursor-pointer"
    >
      <span class="w-2 h-2 rounded-full bg-aneley-yellow animate-pulse"></span>
      <span>Matrículas año 2027</span>
    </button>

    <button
      type="button"
      data-open-admission-modal
      aria-label="Ver información de Matrículas año 2027"
      class="relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-aneley-purple hover:bg-aneley-purple-light text-white border-2 border-aneley-yellow shadow-pill hover:scale-110 active:scale-95 transition-all duration-300 cursor-pointer"
    >
      <!-- Subtle Pulse Ring -->
      <span
        class="absolute inset-0 rounded-full bg-aneley-yellow opacity-30 animate-ping pointer-events-none"
      ></span>

      <!-- Academic / Admission Icon -->
      <svg
        class="w-7 h-7 sm:w-8 sm:h-8 relative z-10"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Floating Action 2: WhatsApp Direct -->
  <div class="flex items-center gap-3 group">
    <!-- Interactive Speech Bubble Tooltip -->
    <a
      href="https://wa.me/56956240280?text=Hola%20Aneley%20Escuela%20Libre%20y%20Feliz,%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20para%20visitas%20y%20postulaciones."
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-white shadow-card border border-aneley-green/20 text-sm font-heading font-bold text-aneley-purple hover:text-aneley-green transition-all duration-300 group-hover:scale-105"
    >
      <span class="w-2 h-2 rounded-full bg-aneley-green animate-pulse"></span>
      <span>¿Hablamos por WhatsApp?</span>
    </a>

    <!-- Floating Action Button -->
    <a
      href="https://wa.me/56956240280?text=Hola%20Aneley%20Escuela%20Libre%20y%20Feliz,%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20para%20visitas%20y%20postulaciones."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Abrir chat de WhatsApp con Aneley Escuela Libre y Feliz"
      class="relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-aneley-green hover:bg-aneley-green-fresh text-white shadow-whatsapp hover:scale-110 active:scale-95 transition-all duration-300"
    >
      <!-- Ripple Ring Animation -->
      <span
        class="absolute inset-0 rounded-full bg-aneley-green opacity-40 animate-ping pointer-events-none"
      ></span>

      <!-- WhatsApp SVG Icon -->
      <svg
        class="w-7 h-7 sm:w-8 sm:h-8 fill-current relative z-10"
        viewBox="0 0 448 512"
        aria-hidden="true"
      >
        <path
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        ></path>
      </svg>
    </a>
  </div>
</div>

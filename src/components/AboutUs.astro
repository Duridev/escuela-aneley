<script>
  // Lazy-load HTML5 video sources only when scrolling near the video container
  const lazyVideos = document.querySelectorAll("video.lazy-video");

  function loadVideo(video: HTMLVideoElement) {
    if (video.dataset.loaded === "true") return;
    const sources = video.querySelectorAll("source[data-src]");
    sources.forEach((source) => {
      const src = source.getAttribute("data-src");
      if (src) {
        source.setAttribute("src", src);
        source.removeAttribute("data-src");
      }
    });
    video.dataset.loaded = "true";
    video.load();
  }

  if ("IntersectionObserver" in window && lazyVideos.length > 0) {
    const videoObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const video = entry.target as HTMLVideoElement;
            loadVideo(video);
            observer.unobserve(video);
          }
        });
      },
      { rootMargin: "250px 0px" },
    );

    lazyVideos.forEach((video) => {
      videoObserver.observe(video);
      video.addEventListener(
        "play",
        () => loadVideo(video as HTMLVideoElement),
        {
          once: true,
        },
      );
    });
  } else {
    lazyVideos.forEach((video) => loadVideo(video as HTMLVideoElement));
  }

  // Initialize mobile carousels (Misión/Visión/Diversidad & 6 Pilares Lefebre Lever)
  document.querySelectorAll<HTMLElement>("[data-mobile-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));

    if (!track || slides.length === 0) return;

    let activeIdx = 0;

    function updateState(idx: number) {
      activeIdx = Math.max(0, Math.min(idx, slides.length - 1));
      dots.forEach((dot, i) => {
        if (i === activeIdx) {
          dot.classList.add("w-7", "bg-aneley-purple");
          dot.classList.remove("w-2.5", "bg-aneley-sand");
        } else {
          dot.classList.remove("w-7", "bg-aneley-purple");
          dot.classList.add("w-2.5", "bg-aneley-sand");
        }
      });
      if (prevBtn) prevBtn.disabled = activeIdx === 0;
      if (nextBtn) nextBtn.disabled = activeIdx === slides.length - 1;
    }

    function goTo(idx: number) {
      const clamped = Math.max(0, Math.min(idx, slides.length - 1));
      const slide = slides[clamped];
      if (!track || !slide) return;
      const targetLeft =
        slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2;
      track.scrollTo({ left: Math.max(0, targetLeft), behavior: "smooth" });
      updateState(clamped);
    }

    prevBtn?.addEventListener("click", () => goTo(activeIdx - 1));
    nextBtn?.addEventListener("click", () => goTo(activeIdx + 1));
    dots.forEach((dot) => {
      dot.addEventListener("click", () => goTo(Number(dot.dataset.dot || 0)));
    });

    let scrollTimer: number | undefined;
    track.addEventListener("scroll", () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const center = track.scrollLeft + track.clientWidth / 2;
        let bestIdx = 0;
        let bestDist = Infinity;
        slides.forEach((slide, i) => {
          const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
          const dist = Math.abs(center - slideCenter);
          if (dist < bestDist) {
            bestDist = dist;
            bestIdx = i;
          }
        });
        updateState(bestIdx);
      }, 60);
    });

    updateState(0);
  });
</script>


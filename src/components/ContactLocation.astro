---
// ContactLocation.astro - Información Práctica, Ubicación en Limache y Formulario de Admisión
---

<section
  id="contacto"
  class="py-20 sm:py-28 bg-gradient-to-b from-white via-aneley-ivory to-aneley-cream relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-aneley-green-soft text-aneley-green font-heading font-bold text-sm uppercase tracking-wider mb-4 border border-aneley-green/20"
      >
        📍 Visítanos en Limache
      </span>
      <h2
        class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-aneley-purple leading-tight tracking-tight mb-4"
      >
        Postulaciones & Contacto Directo
      </h2>
      <p
        class="font-body text-base sm:text-lg text-aneley-text-muted leading-relaxed"
      >
        Ven a conocer nuestro espacio, los árboles, las salas y a conversar con
        nuestro equipo. Las puertas de Aneley están abiertas para tu familia.
      </p>
    </div>

    <!-- 2 Columns: Mobile = Form first / Desktop = Practical Info & Map left, Form right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Practical Details & Map Card (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-6 order-2 lg:order-1">
        <!-- Info Box -->
        <div
          class="bg-white rounded-3xl p-7 shadow-card border border-aneley-sand/60"
        >
          <h3
            class="font-heading font-bold text-xl text-aneley-purple mb-5 flex items-center gap-2.5"
          >
            <span>🏡</span> Datos Prácticos de la Escuela
          </h3>

          <div class="space-y-4 text-smm">
            <!-- Direccion -->
            <div class="flex items-start gap-3.5">
              <div
                class="w-10 h-10 rounded-2xl bg-aneley-purple-soft text-aneley-purple flex items-center justify-center text-lg shrink-0 mt-0.5"
              >
                📍
              </div>
              <div>
                <strong class="block font-heading text-aneley-purple text-base"
                  >Dirección</strong
                >
                <p class="text-aneley-text-muted">
                  Condell 877, Limache, Región de Valparaíso, Chile (Código
                  Postal 2240000)
                </p>
                <p class="text-sm text-aneley-yellow font-semibold mt-0.5">
                  A pasos de locomoción colectiva y vías principales
                </p>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-start gap-3.5">
              <div
                class="w-10 h-10 rounded-2xl bg-aneley-yellow-soft text-aneley-yellow flex items-center justify-center text-lg shrink-0 mt-0.5"
              >
                ⏰
              </div>
              <div>
                <strong class="block font-heading text-aneley-purple text-base"
                  >Horario de Atención</strong
                >
                <p class="text-aneley-text-muted">
                  Lunes a Viernes de 08:00 a 18:00 hrs
                </p>
                <p class="text-sm text-aneley-text-muted">
                  Jornada pedagógica matutina y talleres de tarde
                </p>
              </div>
            </div>

            <!-- WhatsApp & Telefono -->
            <div class="flex items-start gap-3.5">
              <div
                class="w-10 h-10 rounded-2xl bg-aneley-green-soft text-aneley-green flex items-center justify-center shrink-0 mt-0.5"
              >
                <svg
                  class="w-5 h-5 fill-current"
                  viewBox="0 0 448 512"
                  aria-hidden="true"
                >
                  <path
                    d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
                  ></path>
                </svg>
              </div>
              <div>
                <strong class="block font-heading text-aneley-purple text-base"
                  >Teléfonos / WhatsApp</strong
                >
                <a
                  href="tel:+56956240280"
                  class="block text-aneley-green font-bold hover:underline"
                  >+56 9 5624 0280</a
                >
                <a
                  href="tel:+56979050649"
                  class="block text-aneley-text-muted hover:underline text-sm"
                  >+56 9 7905 0649</a
                >
              </div>
            </div>

            <!-- Correo Electronico -->
            <div class="flex items-start gap-3.5">
              <div
                class="w-10 h-10 rounded-2xl bg-aneley-pink-soft text-aneley-pink flex items-center justify-center text-lg shrink-0 mt-0.5"
              >
                ✉️
              </div>
              <div>
                <strong class="block font-heading text-aneley-purple text-base"
                  >Correo Oficial</strong
                >
                <a
                  href="mailto:Aneleylibreyfeliz@gmail.com"
                  class="text-aneley-purple hover:underline font-semibold break-all"
                >
                  Aneleylibreyfeliz@gmail.com
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Visual Map Embed Card -->
        <div
          class="bg-white rounded-3xl overflow-hidden shadow-card border border-aneley-sand/60"
        >
          <div
            class="p-4 bg-aneley-purple-surface border-b border-aneley-sand/40 flex items-center justify-between"
          >
            <span
              class="font-heading font-bold text-sm uppercase tracking-wider text-aneley-purple flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-aneley-green"></span> Mapa Satelital
              · Limache
            </span>
            <a
              href="https://maps.google.com/?q=-32.9886301,-71.2645447"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-bold text-aneley-purple hover:underline"
            >
              Abrir en Google Maps ↗
            </a>
          </div>
          <div class="h-64 w-full bg-aneley-ivory relative">
            <iframe
              title="Ubicación de Aneley Escuela Libre y Feliz en Limache"
              class="w-full h-full border-0"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              src="https://maps.google.com/maps?q=-32.9886301,-71.2645447&hl=es&z=15&output=embed"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Admission Form (lg:col-span-7) -->
      <div class="lg:col-span-7 order-1 lg:order-2">
        <div
          class="relative rounded-3xl p-7 sm:p-10 bg-gradient-to-br from-aneley-purple via-aneley-purple-deep to-aneley-purple text-white shadow-2xl ring-4 ring-aneley-purple/15 overflow-hidden"
        >
          <!-- Top Brand Accent Strip -->
          <div
            class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-aneley-yellow via-aneley-pink to-aneley-green"
            aria-hidden="true"
          >
          </div>

          <!-- Subtle Ambient Glows -->
          <div
            class="absolute -top-20 -right-20 w-56 h-56 rounded-full bg-aneley-yellow/15 blur-3xl pointer-events-none"
            aria-hidden="true"
          >
          </div>
          <div
            class="absolute -bottom-24 -left-16 w-60 h-60 rounded-full bg-aneley-pink/15 blur-3xl pointer-events-none"
            aria-hidden="true"
          >
          </div>

          <div class="relative z-10 mb-8 pt-2">
            <span
              class="px-3.5 py-1 rounded-full bg-aneley-yellow text-aneley-text font-heading font-extrabold text-xs sm:text-sm uppercase tracking-wider inline-block mb-3 shadow-sm"
            >
              Admisiones Ciclo Escolar
            </span>
            <h3
              class="font-heading font-extrabold text-2xl sm:text-3xl text-white leading-tight"
            >
              Solicitud de Visita & Postulación
            </h3>
            <p class="text-sm sm:text-smm text-white/85 mt-1.5 leading-relaxed">
              Completa este breve formulario y nuestro equipo se contactará
              contigo por WhatsApp para coordinar una visita personalizada.
            </p>
          </div>

          <!-- The Form (WhatsApp Message Builder) -->
          <form id="admission-form" class="relative z-10 space-y-5">
            <!-- Parent Name -->
            <div>
              <label
                for="parent-name"
                class="block font-heading font-bold text-smm text-white mb-1.5"
              >
                Tu nombre (Madre, Padre o Apoderado/a) *
              </label>
              <input
                type="text"
                id="parent-name"
                name="parentName"
                required
                placeholder="Ej. Carolina Tapia González"
                class="w-full px-4 py-3.5 rounded-2xl bg-white text-aneley-text placeholder:text-aneley-text-muted/70 border-2 border-white/20 focus:border-aneley-yellow focus:ring-2 focus:ring-aneley-yellow/40 focus:outline-none transition-all text-smm font-medium shadow-sm"
              />
            </div>

            <!-- Level / Reason -->
            <div>
              <label
                for="student-cycle"
                class="block font-heading font-bold text-smm text-white mb-1.5"
              >
                Nivel o motivo de consulta *
              </label>
              <select
                id="student-cycle"
                name="studentCycle"
                required
                class="w-full px-4 py-3.5 rounded-2xl bg-white text-aneley-text border-2 border-white/20 focus:border-aneley-yellow focus:ring-2 focus:ring-aneley-yellow/40 focus:outline-none transition-all text-smm font-medium shadow-sm"
              >
                <option value="" disabled selected
                  >Selecciona un nivel o motivo...</option
                >
                <option value="Primer Ciclo (1° y 2° Básico)"
                  >Primer Ciclo (1° y 2° Básico)</option
                >
                <option value="Ciclo Intermedio (3° y 4° Básico)"
                  >Ciclo Intermedio (3° y 4° Básico)</option
                >
                <option value="Ciclo Superior (5° a 8° Básico)"
                  >Ciclo Superior (5° a 8° Básico)</option
                >
                <option value="Otra consulta pedagógica"
                  >Otra consulta pedagógica</option
                >
              </select>
            </div>

            <!-- Message / Inquiry -->
            <div>
              <label
                for="inquiry-message"
                class="block font-heading font-bold text-smm text-white mb-1.5"
              >
                Mensaje o consulta breve *
              </label>
              <textarea
                id="inquiry-message"
                name="inquiryMessage"
                rows="4"
                required
                placeholder="Cuéntanos brevemente en qué podemos ayudarte o si deseas coordinar una visita guiada..."
                class="w-full px-4 py-3.5 rounded-2xl bg-white text-aneley-text placeholder:text-aneley-text-muted/70 border-2 border-white/20 focus:border-aneley-yellow focus:ring-2 focus:ring-aneley-yellow/40 focus:outline-none transition-all text-smm font-medium resize-none shadow-sm"
              ></textarea>
            </div>

            <!-- Single WhatsApp Submit Button + Helper Note -->
            <div class="pt-2 space-y-3">
              <button
                type="submit"
                id="submit-form-btn"
                class="w-full py-4 px-6 rounded-full bg-aneley-green hover:bg-aneley-green-fresh text-white font-heading font-bold text-smm sm:text-base shadow-xl border-2 border-white/25 hover:border-white/50 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 flex items-center justify-center gap-2.5"
              >
                <svg
                  class="w-5 h-5 fill-current shrink-0"
                  viewBox="0 0 448 512"
                  aria-hidden="true"
                >
                  <path
                    d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
                  ></path>
                </svg>
                <span>Enviar consulta por WhatsApp</span>
              </button>

              <p class="text-center text-xs sm:text-sm text-white/80">
                Se abrirá WhatsApp en una nueva pestaña con tu mensaje listo
                para enviar.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("admission-form") as HTMLFormElement | null;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const parentName =
      (document.getElementById("parent-name") as HTMLInputElement)?.value.trim() ||
      "";
    const studentCycle =
      (document.getElementById("student-cycle") as HTMLSelectElement)?.value ||
      "";
    const inquiryMessage =
      (document.getElementById("inquiry-message") as HTMLTextAreaElement)?.value.trim() ||
      "";

    const message = [
      "Hola Aneley Escuela Libre y Feliz,",
      "",
      "Les escribo desde el sitio web para realizar una consulta:",
      "",
      `*Nombre:* ${parentName}`,
      `*Nivel de interés:* ${studentCycle}`,
      `*Consulta:* ${inquiryMessage}`,
    ].join("\n");

    const waUrl = `https://wa.me/56956240280?text=${encodeURIComponent(message)}`;
    window.open(waUrl, "_blank", "noopener,noreferrer");
  });
</script>

---
// Hero.astro - Sección Hero cálida, luminosa y con estética campestre y moderna
---

<section
  id="inicio"
  class="relative pt-28 sm:pt-36 pb-0 overflow-hidden bg-gradient-to-b from-aneley-ivory/60 via-aneley-cream to-aneley-cream"
>
  <!-- Decorative Background Organic Elements -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full pointer-events-none -z-10 overflow-hidden">
    <!-- Gentle Sun Glow -->
    <div class="absolute top-0 right-10 sm:right-1/4 w-72 sm:w-96 h-72 sm:h-96 rounded-full bg-aneley-yellow-sun/15 blur-3xl"></div>
    <!-- Soft Purple Glow -->
    <div class="absolute top-32 -left-20 w-80 h-80 rounded-full bg-aneley-purple/10 blur-3xl"></div>
    <!-- Fresh Green Glow -->
    <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-aneley-green-light/15 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Content Column -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Animated Badge / Location Tag -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/90 border border-aneley-yellow-warm shadow-sm mb-6 animate-seesaw">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-aneley-yellow opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-aneley-yellow"></span>
          </span>
          <span class="text-sm sm:text-smm font-bold text-aneley-text tracking-wide">
            🌱 Enseñanza Básica Completa (1° a 8° Básico) · Limache
          </span>
        </div>

        <!-- Main Heading -->
        <h1 class="font-heading font-extrabold text-3xl sm:text-5xl lg:text-5xl xl:text-6xl text-aneley-purple leading-[1.15] tracking-tight mb-6">
          Aprender a través de la{" "}
          <span class="text-aneley-yellow drop-shadow-sm underline decoration-aneley-yellow/40 decoration-wavy decoration-2">
            experiencia
          </span>
          , el <span class="text-aneley-green">juego</span> y el movimiento, de
          la mano de las <span class="text-aneley-purple-light">emociones</span>
        </h1>

        <!-- Empathetic Subtitle -->
        <p class="font-body text-base sm:text-lg lg:text-xl text-aneley-text-muted leading-relaxed mb-8 max-w-2xl font-normal">
          Somos un <strong>espacio educativo libre y feliz</strong> que ofrece a
          niños y niñas una educación vivencial, amigable y significativa, en{" "}
          <strong>cocrianza con las familias</strong> y respetando su biología.
          Seguimos el <strong>Método Lefebre Lever</strong> abordando el
          currículum escolar <strong>MINEDUC</strong> de 1° a 8° básico.
        </p>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-10">
          <!-- Primary Button (Purple) -->
          <a
            href="#nosotros"
            class="group inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-aneley-purple hover:bg-aneley-purple-light text-white font-heading font-bold text-base shadow-pill hover:shadow-hover hover:-translate-y-1 transition-all duration-300"
          >
            <span>Conoce nuestro espacio</span>
            <svg
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path>
            </svg>
          </a>

          <!-- WhatsApp Button (Green) -->
          <a
            href="https://wa.me/56956240280?text=Hola%20Aneley%20Escuela%20Libre%20y%20Feliz,%20me%20gustar%C3%ADa%20coordinar%20una%20visita%20y%20conocer%20la%20propuesta%20educativa."
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-aneley-green hover:bg-aneley-green-fresh text-white font-heading font-bold text-base shadow-whatsapp hover:shadow-hover hover:-translate-y-1 transition-all duration-300"
          >
            <svg
              class="w-5 h-5 fill-current shrink-0"
              viewBox="0 0 448 512"
              aria-hidden="true"
            >
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
            </svg>
            <span>Escríbenos por WhatsApp</span>
          </a>
        </div>

        <!-- Quick Value Highlights Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full pt-6 border-t border-aneley-sand/60">
          <div class="flex items-center gap-2.5 p-2 rounded-2xl bg-white/70">
            <span class="text-2xl">🌱</span>
            <span class="text-sm font-bold text-aneley-text">
              Respeto a la biología y emociones
            </span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-2xl bg-white/70">
            <span class="text-2xl">🦋</span>
            <span class="text-sm font-bold text-aneley-text">
              Formando en la diversidad
            </span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-2xl bg-white/70">
            <span class="text-2xl">🤝</span>
            <span class="text-sm font-bold text-aneley-text">
              Cocrianza junto a las familias
            </span>
          </div>
        </div>
      </div>

      <!-- Right Visual Column (Composed Collage with Official Badge & Nature Imagery) -->
      <div class="lg:col-span-5 relative">
        <!-- Floating Butterfly Decorative SVG from Logo -->
        <div
          class="absolute -top-10 -right-4 sm:-right-8 w-16 h-16 sm:w-20 sm:h-20 z-20 animate-flutter pointer-events-none"
          title="Mariposa de Aneley"
        >
          <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-md">
            <!-- Butterfly Left Wing -->
            <path
              d="M50 50 C30 20 5 30 15 60 C20 75 40 70 50 55 Z"
              fill="#E84382"
            ></path>
            <path
              d="M48 48 C35 30 18 36 24 55 C28 65 42 62 48 52 Z"
              fill="#FFCA3A"
            ></path>
            <!-- Butterfly Right Wing -->
            <path
              d="M50 50 C70 20 95 30 85 60 C80 75 60 70 50 55 Z"
              fill="#E84382"
            ></path>
            <path
              d="M52 48 C65 30 82 36 76 55 C72 65 58 62 52 52 Z"
              fill="#FFCA3A"
            ></path>
            <!-- Butterfly Body -->
            <ellipse cx="50" cy="50" rx="3" ry="16" fill="#4E1D60"></ellipse>
            <!-- Antennae -->
            <path
              d="M49 35 Q45 25 40 22 M51 35 Q55 25 60 22"
              stroke="#4E1D60"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
            ></path>
          </svg>
        </div>

        <!-- Main Hero Card Container -->
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Outer Organic Ring Decoration -->
          <div class="absolute -inset-3 sm:-inset-4 bg-gradient-to-tr from-aneley-purple via-aneley-yellow to-aneley-green rounded-[2.5rem] opacity-30 blur-lg transform -rotate-1"></div>

          <div class="relative rounded-[2.2rem] overflow-hidden bg-white shadow-2xl border-4 border-white">
            <!-- Main Hero Image (Happy outdoor nature school kids) -->
            <div class="relative h-80 sm:h-96 w-full overflow-hidden bg-aneley-ivory">
              <img
                src="/hero.jpg"
                alt="Niños y niñas felices aprendiendo en Aneley Escuela Libre y Feliz en Limache"
                class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700"
                loading="eager"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-aneley-purple-deep/70 via-transparent to-black/10"></div>

              <!-- Bottom Overlay Caption -->
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <span class="inline-block px-3 py-1 rounded-full bg-aneley-yellow text-aneley-text font-heading font-bold text-sm uppercase tracking-wider mb-1">
                  Desde 2018 en Limache · 1° a 8° Básico
                </span>
                <p class="font-heading font-semibold text-smm sm:text-base text-white/95 leading-snug">
                  "Aprender a través de la experiencia, el juego y el
                  movimiento, de la mano de las emociones."
                </p>
              </div>
            </div>

            <!-- Bottom Floating Strip with School Badge -->
            <div class="p-4 sm:p-5 bg-gradient-to-r from-aneley-purple-surface to-white flex items-center justify-between gap-4 border-t border-aneley-sand/40">
              <div class="flex items-center gap-3">
                <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-aneley-yellow shadow-md shrink-0">
                  <img
                    src="/logo-aneley.webp"
                    alt="Logo Aneley"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div>
                  <p class="font-heading font-bold text-smm text-aneley-purple">
                    Aneley Limache
                  </p>
                  <p class="text-sm text-aneley-text-muted">
                    Espacio Libre, Activo y Respetuoso
                  </p>
                </div>
              </div>

              <div class="text-right self-start shrink-0">
                <span class="inline-flex items-center gap-1 text-sm font-bold text-aneley-green bg-aneley-green-soft px-2.5 py-1 rounded-full whitespace-nowrap">
                  <svg
                    class="w-3.5 h-3.5 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    ></path>
                  </svg>
                  Visitas Abiertas
                </span>
              </div>
            </div>
          </div>

          <!-- Secondary Floating Badge: Método Lefebre Lever -->
          <div class="absolute -bottom-8 -right-3 sm:-right-6 z-20 bg-white/95 backdrop-blur-md rounded-2xl p-3 sm:p-4 shadow-card border border-aneley-purple/15 flex items-center gap-3 animate-float max-w-[240px] sm:max-w-xs">
            <div class="w-10 h-10 rounded-xl bg-aneley-yellow-soft flex items-center justify-center text-xl shrink-0">
              🌻
            </div>
            <div>
              <p class="font-heading font-bold text-sm text-aneley-purple leading-tight">
                Método Lefebre Lever
              </p>
              <p class="text-[11px] text-aneley-text-muted leading-tight mt-0.5">
                Neurociencias, empatía y respeto al ser
              </p>
            </div>
          </div>

          <!-- Tertiary Floating Badge: Co-crianza -->
          <div class="hidden sm:flex absolute -top-5 -left-5 bg-white/95 backdrop-blur-md rounded-2xl px-4 py-2.5 shadow-card border border-aneley-green/20 items-center gap-2.5">
            <span class="text-lg">🏡</span>
            <span class="text-sm font-bold text-aneley-green">
              Escuela + Familia en Sintonía
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Organic Wave Transition to Next Section -->
  <div class="w-full overflow-hidden leading-none mt-8 sm:mt-10">
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      class="relative block w-full h-8 sm:h-12 text-aneley-ivory/50 fill-current"
    >
      <path d="M0,0 C150,90 350,-40 500,45 C650,130 900,10 1200,50 L1200,120 L0,120 Z"></path>
    </svg>
  </div>
</section>

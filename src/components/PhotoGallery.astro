---

<div class="mt-16 pt-12 border-t border-aneley-sand/50">
  <!-- Gallery Sub-header -->
  <div class="text-center max-w-2xl mx-auto mb-10">
    <span
      class="inline-block px-4 py-1 rounded-full bg-aneley-purple-soft text-aneley-purple font-heading font-bold text-xs sm:text-sm uppercase tracking-wider mb-3"
    >
      Galería de Momentos
    </span>
    <h3
      class="font-heading font-extrabold text-2xl sm:text-3xl text-aneley-purple leading-tight"
    >
      Postales de nuestra comunidad
    </h3>
  </div>

  <!-- Initial 2 Rows (Always Visible) -->
  <div
    class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 auto-rows-[150px] sm:auto-rows-[185px] lg:auto-rows-[210px] grid-flow-dense"
  >
    {
      initialPhotos.map((photo) => (
        <button
          type="button"
          data-lightbox-src={photo.src}
          data-lightbox-alt={photo.alt}
          class={`gallery-photo-btn ${photo.span} group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-aneley-ivory shadow-sm hover:shadow-card border-2 border-white/90 focus:outline-none focus:ring-2 focus:ring-aneley-purple/50 transition-all duration-300 cursor-zoom-in`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-aneley-purple-deep/0 group-hover:bg-aneley-purple-deep/15 transition-colors duration-300" />
        </button>
      ))
    }
  </div>

  <!-- Expandable Container (Slides down smoothly when opened) -->
  <div
    id="extra-gallery-wrapper"
    class="extra-gallery-wrapper overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="pt-3 sm:pt-4 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 auto-rows-[150px] sm:auto-rows-[185px] lg:auto-rows-[210px] grid-flow-dense"
    >
      {
        extraPhotos.map((photo) => (
          <button
            type="button"
            data-lightbox-src={photo.src}
            data-lightbox-alt={photo.alt}
            class={`gallery-photo-btn ${photo.span} group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-aneley-ivory shadow-sm hover:shadow-card border-2 border-white/90 focus:outline-none focus:ring-2 focus:ring-aneley-purple/50 transition-all duration-300 cursor-zoom-in`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-aneley-purple-deep/0 group-hover:bg-aneley-purple-deep/15 transition-colors duration-300" />
          </button>
        ))
      }
    </div>
  </div>

  <!-- Full-Width Divider Line + Expand/Collapse Button (Moves down smoothly with the gallery) -->
  <div class="relative flex items-center justify-center mt-8">
    <div
      class="w-full h-px bg-gradient-to-r from-aneley-sand/30 via-aneley-purple/35 to-aneley-sand/30"
      aria-hidden="true"
    >
    </div>

    <button
      type="button"
      id="toggle-gallery-btn"
      aria-expanded="false"
      aria-controls="extra-gallery-wrapper"
      class="absolute inline-flex items-center gap-2.5 px-6 py-2.5 rounded-full bg-white hover:bg-aneley-purple text-aneley-purple hover:text-white font-heading font-bold text-sm sm:text-smm shadow-card border border-aneley-purple/20 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0"
    >
      <span id="toggle-gallery-label">Expandir galería</span>
      <svg
        id="toggle-gallery-icon"
        class="w-4 h-4 transition-transform duration-500"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
  </div>
</div>

<!-- Simple Lightbox Modal for full-size viewing -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 backdrop-blur-sm p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Vista ampliada de fotografía"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Cerrar vista ampliada"
    class="absolute top-4 right-4 sm:top-6 sm:right-6 w-11 h-11 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition-colors"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  <img
    id="lightbox-img"
    src=""
    alt=""
    class="max-h-[88vh] max-w-[92vw] rounded-2xl object-contain shadow-2xl"
  />
</div>

<style>
  .extra-gallery-wrapper {
    max-height: 0;
    opacity: 0;
    transition:
      max-height 700ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 450ms ease;
  }
  .extra-gallery-wrapper.is-open {
    opacity: 1;
  }
</style>

<script>
  const wrapper = document.getElementById("extra-gallery-wrapper");
  const toggleBtn = document.getElementById("toggle-gallery-btn");
  const toggleLabel = document.getElementById("toggle-gallery-label");
  const toggleIcon = document.getElementById("toggle-gallery-icon");

  let isExpanded = false;

  toggleBtn?.addEventListener("click", () => {
    if (!wrapper) return;
    isExpanded = !isExpanded;

    toggleBtn.setAttribute("aria-expanded", String(isExpanded));
    wrapper.setAttribute("aria-hidden", String(!isExpanded));

    if (isExpanded) {
      wrapper.classList.add("is-open");
      wrapper.style.maxHeight = `${wrapper.scrollHeight}px`;
      if (toggleLabel) toggleLabel.textContent = "Mostrar menos";
      toggleIcon?.classList.add("rotate-180");

      // After transition ends, allow natural height in case of window resize
      const onEnd = () => {
        if (isExpanded) wrapper.style.maxHeight = "none";
        wrapper.removeEventListener("transitionend", onEnd);
      };
      wrapper.addEventListener("transitionend", onEnd);
    } else {
      // Lock current pixel height before collapsing to 0 for smooth slide-up
      wrapper.style.maxHeight = `${wrapper.scrollHeight}px`;
      void wrapper.offsetHeight; // force reflow
      wrapper.classList.remove("is-open");
      wrapper.style.maxHeight = "0px";
      if (toggleLabel) toggleLabel.textContent = "Expandir galería";
      toggleIcon?.classList.remove("rotate-180");
    }
  });

  // Lightbox logic
  const lightbox = document.getElementById("gallery-lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("lightbox-close");
  const photoBtns = document.querySelectorAll<HTMLButtonElement>(".gallery-photo-btn");

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  photoBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = btn.dataset.lightboxSrc || "";
      lightboxImg.alt = btn.dataset.lightboxAlt || "";
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    });
  });

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
      closeLightbox();
    }
  });
</script>
